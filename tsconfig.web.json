{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out/renderer",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/renderer/**/*",
    "src/common/**/*"
  ],
  "exclude": [
    "**/_archive/**"
  ]
}