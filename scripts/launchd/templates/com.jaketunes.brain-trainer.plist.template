<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Brief 183 template — com.jaketunes.brain-trainer (nightly brain training,
     scripts/brain-trainer.mjs; 02:00 evidenced in the trainer's header).
     Path tokens are rendered by install-launchagents.sh. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.jaketunes.brain-trainer</string>
  <key>ProgramArguments</key><array>
    <string>__NODE__</string>
    <string>__REPO__/scripts/brain-trainer.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/jaketunes-brain-trainer.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/jaketunes-brain-trainer.log</string>
</dict></plist>
