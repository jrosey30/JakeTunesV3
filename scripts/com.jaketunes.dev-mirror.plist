<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jaketunes.dev-mirror</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jacobrosenbaum/.local/bin/jaketunes-dev-mirror.sh</string>
    </array>
    <!-- Every 5 minutes + at load. Cheap (a rev-list check per repo); a push
         only fires when there are new commits, so nothing committed stays
         laptop-only for more than ~5 min. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jacobrosenbaum/Library/Logs/jaketunes-dev-mirror.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacobrosenbaum/Library/Logs/jaketunes-dev-mirror.err.log</string>
</dict>
</plist>
