<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jaketunes.scotus-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jacobrosenbaum/.local/bin/scotus-archive-backup.sh</string>
    </array>
    <!-- Daily at 04:30, plus once whenever the agent loads (login/reboot).
         The vault rarely changes, so daily is ample; a per-minute cadence
         would needlessly touch the NAS. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jacobrosenbaum/Library/Logs/jaketunes-scotus-backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacobrosenbaum/Library/Logs/jaketunes-scotus-backup.err.log</string>
</dict>
</plist>
